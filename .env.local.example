# Copy to .env.local and fill in. Never commit .env.local.

# --- required before anything runs -----------------------------------------
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# QuickNode -> create a Solana *devnet* endpoint, enable the Priority Fee add-on
QUICKNODE_RPC_URL=

# --- provisioned automatically by `vercel integration add upstash` ----------
# then `vercel env pull .env.local`
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- created by `npx tsx scripts/mint-pool.ts` ------------------------------
# Run it once with these blank; it prints what to paste back here.
# Treasury pays every worker. Workers never sign, so no worker keys are stored.
TREASURY_SECRET_KEY=
TOKEN_MINT=

# --- optional ---------------------------------------------------------------
# Wallets pre-created for the audience to claim on scan.
POOL_SIZE=60
